<form method="post" action="{{ path('app_contact_crud_contaller_delete', {'id_contact': contact.id_contact}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id_contact) }}">
    <button class="btn">Delete</button>
</form>
