{% extends 'base.html.twig' %}

{% block title %}Ajouter un service{% endblock %}

{% block body %}
    <h1>Ajouter un nouveau service</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.description) }}
        {{ form_row(form.horaire_ouverture) }}
        {{ form_row(form.horaire_fermeture) }}
        <button class="btn">Ajouter</button>
    {{ form_end(form) }}

    <a href="{{ path('services') }}">Retour à la liste des services</a>
{% endblock %}
