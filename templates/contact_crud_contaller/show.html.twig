{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <h1>Contact</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_contact</th>
                <td>{{ contact.idContact }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ contact.nom }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ contact.email }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ contact.message }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ contact.date ? contact.date|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_contact_crud_contaller_index') }}">back to list</a>

    <a href="{{ path('app_contact_crud_contaller_edit', {'id_contact': contact.id_contact}) }}">edit</a>

    {{ include('contact_crud_contaller/_delete_form.html.twig') }}
{% endblock %}
