{% extends 'base.html.twig' %}

{% block title %}Contact index{% endblock %}

{% block body %}
    <h1>Contact index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_contact</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Message</th>
                <th>Date</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for contact in contacts %}
            <tr>
                <td>{{ contact.idContact }}</td>
                <td>{{ contact.nom }}</td>
                <td>{{ contact.email }}</td>
                <td>{{ contact.message }}</td>
                <td>{{ contact.date ? contact.date|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_contact_crud_contaller_show', {'id_contact': contact.id_contact}) }}">show</a>
                    <a href="{{ path('app_contact_crud_contaller_edit', {'id_contact': contact.id_contact}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_contact_crud_contaller_new') }}">Create new</a>
{% endblock %}
