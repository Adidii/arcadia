 {% extends 'base.html.twig' %}

{% block title %}Accueil - Zoo1{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
{% endblock %}

{% block body %}
    <!-- Navbar -->
    <header>
        <nav class="navbar">
            <a href="{{ path('home') }}" class="logo">Zoo1</a>
            <ul class="nav-links">
                <li><a href="{{ path('services') }}">Services</a></li>
                <li><a href="{{ path('avis') }}">Avis</a></li>
                <li><a href="{{ path('horaires') }}">Horaires</a></li>
                <li><a href="{{ path('contact') }}">Contact</a></li>
                <li><a href="{{ path('habitat_list') }}">Habitats</a></li>
                <li><a href="{{ path('app_register') }}">Inscription</a></li>
                <li><a href="{{ path('app_login') }}">Connexion</a></li>
            </ul>
        </nav>
    </header>

    <!-- Slider -->
    <section class="slider">
        <div class="slide">
            <img src="{{ asset('images/image1.jpeg') }}" alt="Image 1">
        </div>
        <div class="slide">
            <img src="{{ asset('images/image2.jpeg') }}" alt="Image 2">
        </div>
        <div class="slide">
            <img src="{{ asset('images/image3.jpeg') }}" alt="Image 3">
        </div>
        <button class="prev" id="prev">&#10094;</button>
        <button class="next" id="next">&#10095;</button>
    </section>

    <main>
        <!-- Services -->
        <section id="services">
            <h2>Nos Services</h2>
            <div class="services-container">
                <div class="service">
                    <img src="{{ asset('images/balade.jpeg') }}" alt="Visites guidées">
                    <h3>Visites guidées</h3>
                    <p>Découvrez le zoo avec un expert pour une expérience enrichissante.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/workshop.jpg') }}" alt="Ateliers éducatifs">
                    <h3>Ateliers éducatifs</h3>
                    <p>Participez à des activités ludiques pour petits et grands.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/restaurant.jpg') }}" alt="Restaurant">
                    <h3>Restaurant</h3>
                    <p>Reposez-vous et profitez de menus adaptés à toute la famille.</p>
                </div>
            </div>
        </section>

        <!-- Horaires & Localisation -->
        <section id="horaires">
            <h2>Horaires & Localisation</h2>
            <div class="services-container">
                <div class="service">
                    <img src="{{ asset('images/open-hours.jpg') }}" alt="Horaires">
                    <h3>Horaires</h3>
                    <p>Lundi - Vendredi : 9h - 18h</p>
                    <p>Samedi - Dimanche : 10h - 20h</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/location.jpg') }}" alt="Localisation">
                    <h3>Localisation</h3>
                    <p>123 Rue des Animaux</p>
                    <p>Paris, France</p>
                </div>
            </div>
        </section>

        <!-- Habitats -->
        <section id="habitats">
            <h2>Nos Habitats</h2>
            <div class="services-container">
                <div class="service">
                    <img src="{{ asset('images/jungle.jpeg') }}" alt="Jungle">
                    <h3>Jungle</h3>
                    <p>Découvrez nos animaux exotiques dans un cadre naturel.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/savane.jpeg') }}" alt="Savane">
                    <h3>Savane</h3>
                    <p>Admirez les lions majestueux et les girafes de la savane.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/aquarium.jpg') }}" alt="Aquarium">
                    <h3>Aquarium</h3>
                    <p>Explorez le monde sous-marin fascinant.</p>
                </div>
            </div>
        </section>

        <!-- Nouveautés -->
        <section id="news">
            <h2>Nouveautés</h2>
            <div class="services-container">
                <div class="service">
                    <img src="{{ asset('images/baby-tiger.jpg') }}" alt="Bébé tigre">
                    <h3>Nouveau bébé tigre !</h3>
                    <p>Venez rencontrer notre nouveau résident.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('images/workshop-event.jpg') }}" alt="Atelier interactif">
                    <h3>Atelier interactif</h3>
                    <p>Apprenez à nourrir les animaux.</p>
                </div>
                <div class="service">
                    <img src="{{ asset('public/images/crepe.jpeg') }}" alt="Festival">
                    <h3>Festival d’été</h3>
                    <p>Rejoignez-nous pour une fête en plein air.</p>
                </div>
            </div>
        </section>

     <!-- Contact -->
    <section id="contact">
        <h2>Contactez-nous</h2>
        <form action="{{ path('contact') }}" method="POST" class="contact-form">
            <div class="form-group">
                <label for="name">Nom</label>
                <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="4" required></textarea>
            </div>
            <button type="submit">Envoyer</button>
        </form>
    </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-container">
            <p>&copy; 2024 Zoo1. Tous droits réservés.</p>
            <ul class="footer-links">
                <li><a href="#">Mentions légales</a></li>
                <li><a href="#">Politique de confidentialité</a></li>
                <li><a href="#">Plan du site</a></li>
            </ul>
        </div>
    </footer>
{% endblock %} 
{% block javascripts %}
    <script src="{{ asset('js/app.js') }}"></script>
{% endblock %}